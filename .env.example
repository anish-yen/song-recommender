# Supabase Postgres: pooled runtime connection (port 6543, append pgbouncer=true)
DATABASE_URL="postgresql://prisma.project_ref:replace_me@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Postgres: session/direct migration connection (port 5432)
DIRECT_URL="postgresql://prisma.project_ref:replace_me@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# A long random secret used only by the server to sign application sessions.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Optional future recommendation service base URL. Without this, discovery clearly uses development mock data.
RECOMMENDATION_API_URL=""
